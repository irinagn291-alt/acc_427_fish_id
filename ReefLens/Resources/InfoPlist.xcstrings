    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a fish for private, on-device identification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere einen Fisch zur privaten Erkennung auf dem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez un poisson pour l’identifier sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía un pez para identificarlo de forma privada en este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝魚類照片，在裝置上私密辨識。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة لسمكة للتعرّف عليها بخصوصية على جهازك."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a fish for private, on-device identification."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a fish for private, on-device identification."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a fish image to analyze locally in Fish ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Fischbild zur lokalen Analyse in Fish ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image à analyser localement dans Fish ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen de un pez para analizarla localmente en Fish ID."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇魚類照片，在 Fish ID 中離線分析。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة سمكة لتحليلها محلياً في Fish ID."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a fish image to analyze locally in Fish ID."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a fish image to analyze locally in Fish ID."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an illustrated card of your confirmed find to Photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Karte deines bestätigten Fundes zu Fotos hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une fiche de votre découverte confirmée dans Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una ficha de tu hallazgo confirmado a Fotos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已確認的觀察卡加入「照片」。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف بطاقة مصوّرة لمشاهدتك المؤكدة إلى تطبيق الصور."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an illustrated card of your confirmed find to Photos."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an illustrated card of your confirmed find to Photos."
          }
        }
      }
