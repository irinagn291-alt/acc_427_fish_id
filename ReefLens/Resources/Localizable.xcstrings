    "challengeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph and confirm 3 different species this season. Observe gently and release fish responsibly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere und bestätige diese Saison 3 verschiedene Arten. Beobachte behutsam und setze Fische schonend zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez et confirmez 3 espèces cette saison. Observez avec soin et relâchez les poissons de façon responsable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía y confirma 3 especies esta temporada. Observa con cuidado y libera los peces de forma responsable."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本季拍攝並確認 3 種不同魚類。觀察時輕柔對待魚隻，並妥善放流。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّر ثلاثة أنواع مختلفة وأكّدها هذا الموسم. تعامل مع الأسماك برفق عند مراقبتها وإطلاقها."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph and confirm 3 different species this season. Observe gently and release fish responsibly."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph and confirm 3 different species this season. Observe gently and release fish responsibly."
          }
        }
      }
    },
