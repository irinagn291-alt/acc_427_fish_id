          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist 模型與分類資料採 MIT 授權。範例照片由美國魚類及野生動物管理局的 Sam Stukel 拍攝，屬公共領域。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
