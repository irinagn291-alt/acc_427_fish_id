    "weeds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated lakes, ponds and slow rivers. Ambushes prey near cover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewachsene Seen, Teiche und langsame Flüsse. Lauert nahe Verstecken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacs, étangs et rivières lentes avec végétation. Chasse à l’affût."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagos, estanques y ríos lentos con vegetación. Caza al acecho."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "棲息於水草繁茂的湖泊、池塘和緩流河段，常在遮蔽物旁伏擊獵物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيش في البحيرات والبرك والأنهار بطيئة الجريان ذات الغطاء النباتي، وتترصّد الفرائس قرب المخابئ."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated lakes, ponds and slow rivers. Ambushes prey near cover."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated lakes, ponds and slow rivers. Ambushes prey near cover."
          }
        }
      }
    },
    "cold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, oxygen-rich rivers and lakes. Feeds on insects and small aquatic animals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kühle, sauerstoffreiche Flüsse und Seen. Frisst Insekten und kleine Wassertiere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivières et lacs frais et oxygénés. Mange des insectes et de petits animaux aquatiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ríos y lagos fríos y oxigenados. Come insectos y pequeños animales acuáticos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "棲息於涼爽、富含氧氣的河流和湖泊，以昆蟲和小型水生動物為食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيش في الأنهار والبحيرات الباردة الغنية بالأكسجين، وتتغذى على الحشرات والحيوانات المائية الصغيرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, oxygen-rich rivers and lakes. Feeds on insects and small aquatic animals."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cool, oxygen-rich rivers and lakes. Feeds on insects and small aquatic animals."
          }
        }
      }
    },
    "lakes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakes and river pools. Feeds on small fish and aquatic invertebrates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen und Flussbecken. Frisst kleine Fische und wirbellose Wassertiere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacs et fosses de rivière. Mange de petits poissons et des invertébrés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagos y pozas fluviales. Come peces pequeños e invertebrados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "棲息於湖泊和河流深潭，以小魚及水生無脊椎動物為食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيش في البحيرات والأحواض النهرية العميقة، وتتغذى على الأسماك الصغيرة واللافقاريات المائية."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakes and river pools. Feeds on small fish and aquatic invertebrates."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakes and river pools. Feeds on small fish and aquatic invertebrates."
          }
        }
      }
    },
    "bottom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, slow water with a soft bottom. Searches sediment for food."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmes, langsames Wasser mit weichem Grund. Sucht im Sediment nach Nahrung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eaux chaudes et lentes à fond meuble. Cherche sa nourriture dans les sédiments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguas cálidas y lentas con fondo blando. Busca alimento en el sedimento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜好溫暖、流速緩慢且底質鬆軟的水域，在沉積物中覓食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفضّل المياه الدافئة بطيئة الجريان ذات القاع الليّن، وتبحث عن الغذاء في الرواسب."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, slow water with a soft bottom. Searches sediment for food."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm, slow water with a soft bottom. Searches sediment for food."
          }
        }
      }
    },
    "rocks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear lakes and rivers with rocky cover. Feeds on crayfish and small fish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klare Seen und Flüsse mit Felsen. Frisst Krebse und kleine Fische."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacs et rivières clairs à fond rocheux. Mange des écrevisses et petits poissons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagos y ríos claros con rocas. Come cangrejos de río y peces pequeños."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "棲息於多岩石的清澈湖泊和河流，以螯蝦和小魚為食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيش في البحيرات والأنهار الصافية ذات الصخور، وتتغذى على جراد المياه العذبة والأسماك الصغيرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear lakes and rivers with rocky cover. Feeds on crayfish and small fish."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear lakes and rivers with rocky cover. Feeds on crayfish and small fish."
          }
        }
      }
    },
    "band": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large mouth extending behind the eye; dark lateral band."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großes Maul bis hinter das Auge; dunkles Seitenband."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande bouche dépassant l’œil ; bande latérale sombre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boca grande que sobrepasa el ojo; banda lateral oscura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘴大，上頜延伸至眼後，體側有深色縱帶。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فم كبير يمتد خلف العين، وشريط داكن على طول الجانب."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Large mouth extending behind the eye; dark lateral band."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Large mouth extending behind the eye; dark lateral band."
          }
        }
