    "privacyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and notes stay on this device. No account, tracking, advertising or uploads. Deleting a find removes its local photo. Backups follow your device settings. Widgets read only a local summary."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Notizen bleiben auf diesem Gerät. Kein Konto, Tracking, Werbung oder Upload. Beim Löschen eines Fundes wird das lokale Foto entfernt. Backups folgen den Geräteeinstellungen. Widgets lesen nur eine lokale Zusammenfassung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos et notes restent sur cet appareil. Aucun compte, suivi, publicité ni envoi. Supprimer une découverte efface sa photo locale. Les sauvegardes suivent les réglages de l’appareil. Les widgets lisent un résumé local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos y notas permanecen en este dispositivo. Sin cuenta, rastreo, publicidad ni envíos. Eliminar un hallazgo borra su foto local. Las copias siguen los ajustes del dispositivo. Los widgets leen un resumen local."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片與筆記保存在此裝置。無需帳號，無追蹤、廣告或上傳。刪除觀察時會移除本機照片。備份依裝置設定執行，小工具僅讀取本機摘要。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الصور والملاحظات على جهازك. لا حسابات أو تتبع أو إعلانات أو رفع للصور. يحذف حذف المشاهدة صورتها المحلية. تتبع النسخ الاحتياطية إعدادات الجهاز وتقرأ الأدوات ملخصاً محلياً فقط."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and notes stay on this device. No account, tracking, advertising or uploads. Deleting a find removes its local photo. Backups follow your device settings. Widgets read only a local summary."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and notes stay on this device. No account, tracking, advertising or uploads. Deleting a find removes its local photo. Backups follow your device settings. Widgets read only a local summary."
          }
        }
      }
    },
    "modelBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist runs on this device. Photo suggestions cover 17 fish species. The illustrated guide has 22 profiles. Scores express the model’s ranking. Check the visible marks and record a species only when you can confirm it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist läuft auf diesem Gerät. Fotovorschläge decken 17 Fischarten ab. Der illustrierte Führer enthält 22 Porträts. Die Werte spiegeln die Rangfolge des Modells wider. Vor dem Speichern die sichtbaren Merkmale prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist fonctionne sur cet appareil. Les suggestions photo couvrent 17 espèces de poissons. Le guide illustré compte 22 fiches. Les scores reflètent le classement du modèle. Vérifiez les traits visibles avant de confirmer une espèce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist se ejecuta en este dispositivo. Las sugerencias fotográficas abarcan 17 especies. La guía ilustrada incluye 22 fichas. Las puntuaciones expresan la clasificación del modelo. Comprueba los rasgos visibles antes de confirmar una especie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist 在裝置上執行，可建議 17 種魚。圖鑑收錄 22 種魚類。分數代表模型的排序，請核對可見特徵後再確認魚種。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل iNaturalist على جهازك. تشمل اقتراحات الصور ١٧ نوعاً من الأسماك ويضم الدليل ٢٢ بطاقة. تعبّر الدرجات عن ترتيب النموذج. تحقّق من العلامات الظاهرة قبل تأكيد النوع."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist runs on this device. Photo suggestions cover 17 fish species. The illustrated guide has 22 profiles. Scores express the model’s ranking. Check the visible marks and record a species only when you can confirm it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist runs on this device. Photo suggestions cover 17 fish species. The illustrated guide has 22 profiles. Scores express the model’s ranking. Check the visible marks and record a species only when you can confirm it."
          }
        }
      }
    },
    "license": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iNaturalist model and taxonomy · MIT licence. Sample photograph by Sam Stukel, U.S. Fish and Wildlife Service · Public domain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
