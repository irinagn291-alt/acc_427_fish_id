    "mark.largemouth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upper jaw reaches past the eye. Follow the broken dark stripe along the side. Florida bass can look almost identical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Oberkiefer reicht hinter das Auge. An der Flanke verläuft ein unterbrochenes dunkles Band. Der Floridabarsch sieht sehr ähnlich aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mâchoire supérieure dépasse l’œil. Suivez la bande sombre discontinue sur le flanc. L’achigan de Floride lui ressemble beaucoup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mandíbula superior sobrepasa el ojo. Una banda oscura discontinua recorre el costado. La lobina de Florida es muy parecida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上顎延伸至眼後，體側有斷續的深色縱帶。外形與佛羅里達黑鱸極為相似。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز الفك العلوي العين ويمتد شريط داكن متقطّع على الجانب. يشبهه قاروص فلوريدا كثيراً."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The upper jaw reaches past the eye. Follow the broken dark stripe along the side. Florida bass can look almost identical."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The upper jaw reaches past the eye. Follow the broken dark stripe along the side. Florida bass can look almost identical."
          }
        }
      }
    },
    "mark.bass": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep notch divides the dorsal fin and the mouth reaches behind the eye. These traits also occur in largemouth bass. A photograph alone cannot reliably separate them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine tiefe Kerbe teilt die Rückenflosse, das Maul reicht hinter das Auge. Diese Merkmale teilt er mit dem Forellenbarsch. Fotos erlauben keine sichere Trennung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aileron dorsal est profondément échancré et la bouche dépasse l’œil. L’achigan à grande bouche partage ces traits. Une photo seule ne permet pas de les distinguer avec certitude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aleta dorsal tiene una hendidura profunda y la boca llega detrás del ojo. La lobina negra comparte estos rasgos. Una foto sola no permite separarlas con certeza."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背鰭中央有深凹，嘴角延伸至眼後。大口黑鱸也有這些特徵，僅憑照片難以可靠區分。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الزعنفة الظهرية ثلمة عميقة ويمتد الفم إلى خلف العين. يشترك القاروص كبير الفم في الصفتين، ويصعب التمييز بينهما من صورة وحدها."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep notch divides the dorsal fin and the mouth reaches behind the eye. These traits also occur in largemouth bass. A photograph alone cannot reliably separate them."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep notch divides the dorsal fin and the mouth reaches behind the eye. These traits also occur in largemouth bass. A photograph alone cannot reliably separate them."
          }
        }
      }
    },
    "mark.western": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a tiny upturned mouth, rounded tail and a dorsal fin far back. Females may show a dark patch near the anal fin. Eastern mosquitofish look very similar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleines, oberständiges Maul, runde Schwanzflosse, weit hinten sitzende Rückenflosse. Weibchen können vor der Afterflosse einen dunklen Fleck tragen. Die östliche Art ähnelt ihr sehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petite bouche tournée vers le haut, queue arrondie et dorsale très en arrière. Une tache sombre peut précéder l’anale des femelles. La gambusie orientale lui ressemble beaucoup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boca pequeña dirigida hacia arriba, cola redonda y dorsal muy retrasada. Las hembras pueden mostrar una mancha oscura junto a la aleta anal. Se parece mucho a la gambusia oriental."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小嘴朝上、尾鰭圓，背鰭靠近尾端。雌魚臀鰭前可見暗斑。與東部食蚊魚外形很接近。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فم صغير متجه إلى أعلى وذيل مستدير وزعنفة ظهرية متأخرة. قد تظهر لدى الإناث بقعة داكنة قرب الزعنفة الشرجية. تشبه كثيراً قريبتها الشرقية."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a tiny upturned mouth, rounded tail and a dorsal fin far back. Females may show a dark patch near the anal fin. Eastern mosquitofish look very similar."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a tiny upturned mouth, rounded tail and a dorsal fin far back. Females may show a dark patch near the anal fin. Eastern mosquitofish look very similar."
          }
        }
      }
    },
    "mark.eastern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small surface swimmer with a level back and rounded tail. Adult males have a narrow, elongated anal fin. Separating the two mosquitofishes requires close inspection of the fins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner Oberflächenfisch mit flachem Rücken und runder Schwanzflosse. Männchen haben eine schmale, verlängerte Afterflosse. Zum Trennen der beiden Arten müssen die Flossen genau untersucht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit poisson de surface au dos plat et à la queue ronde. L’anale du mâle adulte est étroite et allongée. Examiner les nageoires de près pour distinguer les deux gambusies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeño pez de superficie con dorso recto y cola redonda. El macho adulto tiene la anal alargada y estrecha. Para distinguir ambas gambusias hay que examinar las aletas de cerca."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小型表層魚，背部平直、尾鰭圓。成熟雄魚的臀鰭狹長。區分兩種食蚊魚需仔細檢查魚鰭構造。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمكة سطحية صغيرة ذات ظهر مستوٍ وذيل مستدير. الزعنفة الشرجية للذكر البالغ ضيقة وطويلة. يتطلب فصل نوعي سمك البعوض فحصاً دقيقاً للزعانف."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A small surface swimmer with a level back and rounded tail. Adult males have a narrow, elongated anal fin. Separating the two mosquitofishes requires close inspection of the fins."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A small surface swimmer with a level back and rounded tail. Adult males have a narrow, elongated anal fin. Separating the two mosquitofishes requires close inspection of the fins."
          }
        }
      }
    },
    "mark.channel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice the deeply forked tail and four pairs of barbels. Small individuals often have scattered black spots. The outer edge of the anal fin is rounded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tief gegabelte Schwanzflosse und vier Bartelpaare. Junge Tiere tragen oft schwarze Punkte. Der Außenrand der Afterflosse ist gerundet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue très fourchue, quatre paires de barbillons. Les petits sujets portent souvent des points noirs. Le bord de l’anale est arrondi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola muy ahorquillada y cuatro pares de barbillones. Los ejemplares pequeños suelen tener puntos negros. El borde de la aleta anal es redondeado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尾鰭深叉，有四對觸鬚。小型個體體側常散布黑點，臀鰭外緣圓弧。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذيل عميق التشعّب وأربعة أزواج من اللوامس. تنتشر على الصغار عادة نقاط سوداء، والحافة الخارجية للزعنفة الشرجية مستديرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice the deeply forked tail and four pairs of barbels. Small individuals often have scattered black spots. The outer edge of the anal fin is rounded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice the deeply forked tail and four pairs of barbels. Small individuals often have scattered black spots. The outer edge of the anal fin is rounded."
          }
        }
      }
    },
    "mark.redbreast": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The narrow black gill flap extends well beyond the gill cover. The breast ranges from orange to brick red, especially in breeding males."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der schmale schwarze Kiemendeckellappen ragt weit nach hinten. Die Brust ist orange bis ziegelrot, besonders bei laichenden Männchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le long lobe operculaire noir est étroit et dépasse nettement l’opercule. La poitrine est orangée à rouge brique, surtout chez le mâle en période de frai."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lóbulo negro y estrecho sobresale mucho del opérculo. El pecho va del naranja al rojo ladrillo, sobre todo en machos reproductores."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "細長的黑色鰓蓋瓣突出鰓蓋後緣。胸部橘至磚紅，繁殖期雄魚尤其明顯。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمتد فص أسود ضيق خلف غطاء الخياشيم. يتراوح لون الصدر بين البرتقالي والأحمر الآجري، خاصة عند الذكور في موسم التكاثر."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The narrow black gill flap extends well beyond the gill cover. The breast ranges from orange to brick red, especially in breeding males."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The narrow black gill flap extends well beyond the gill cover. The breast ranges from orange to brick red, especially in breeding males."
          }
        }
      }
    },
    "mark.green": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mouth is large for a sunfish, with the upper jaw reaching the middle of the eye. Blue-green lines cross the cheek. The pectoral fin is short and rounded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Sonnenbarsch großes Maul. Der Oberkiefer reicht bis zur Augenmitte. Blaugrüne Linien auf der Wange und kurze, rundliche Brustflossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande bouche pour un crapet, mâchoire supérieure atteignant le milieu de l’œil. Des lignes bleu-vert traversent la joue. La pectorale est courte et arrondie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boca grande para un pez sol. La mandíbula superior alcanza el centro del ojo. Líneas verdeazuladas en la mejilla y pectoral corta y redonda."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘴比多數太陽魚大，上顎達眼中部。頰部有藍綠色線紋，胸鰭短而圓。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فمه كبير لسمكة شمس ويصل الفك العلوي إلى منتصف العين. تعبر الخد خطوط زرقاء مخضرة، والزعنفة الصدرية قصيرة ومستديرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The mouth is large for a sunfish, with the upper jaw reaching the middle of the eye. Blue-green lines cross the cheek. The pectoral fin is short and rounded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The mouth is large for a sunfish, with the upper jaw reaching the middle of the eye. Blue-green lines cross the cheek. The pectoral fin is short and rounded."
          }
        }
      }
    },
    "mark.pumpkin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A red or orange spot tips the dark gill flap. Wavy turquoise lines cross the cheek and the deep body is flecked with copper or gold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende des dunklen Kiemendeckellappens sitzt ein roter oder oranger Fleck. Türkise Wellenlinien auf der Wange, kupferne oder goldene Punkte auf dem hohen Körper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lobe operculaire sombre se termine par une tache rouge ou orange. La joue porte des lignes turquoise ondulées, le corps haut des points cuivrés ou dorés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lóbulo oscuro del opérculo termina en una mancha roja o naranja. Líneas turquesa onduladas en la mejilla y motas cobrizas o doradas en el cuerpo alto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色鰓蓋瓣末端有橘紅斑。頰上有波浪狀藍綠線紋，高身側面散布銅色或金色斑點。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر بقعة حمراء أو برتقالية عند طرف فص الخياشيم الداكن. على الخد خطوط فيروزية متموجة وعلى الجسم العريض نقط نحاسية أو ذهبية."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A red or orange spot tips the dark gill flap. Wavy turquoise lines cross the cheek and the deep body is flecked with copper or gold."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A red or orange spot tips the dark gill flap. Wavy turquoise lines cross the cheek and the deep body is flecked with copper or gold."
          }
        }
      }
    },
    "mark.yellow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six to eight dark vertical bars cross yellow-green sides. The first of the two dorsal fins is spiny. The pelvic and anal fins often have an orange tint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs bis acht dunkle Querbinden auf gelbgrünen Flanken. Die erste der zwei Rückenflossen ist stachelig. Bauch- und Afterflossen sind oft orange getönt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six à huit bandes verticales sombres traversent les flancs jaune-vert. La première dorsale est épineuse. Les pelviennes et l’anale sont souvent teintées d’orange."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De seis a ocho barras verticales oscuras sobre flancos amarillo verdosos. La primera dorsal es espinosa. Las aletas pélvicas y anal suelen ser anaranjadas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黃綠色體側有六至八條深色橫帶，第一背鰭具硬棘，腹鰭和臀鰭常帶橙色。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستة إلى ثمانية أشرطة داكنة عمودية على جانب أصفر مخضر. أولى الزعنفتين الظهريتين شوكية، وغالباً ما تميل الزعانف الحوضية والشرجية إلى البرتقالي."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Six to eight dark vertical bars cross yellow-green sides. The first of the two dorsal fins is spiny. The pelvic and anal fins often have an orange tint."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Six to eight dark vertical bars cross yellow-green sides. The first of the two dorsal fins is spiny. The pelvic and anal fins often have an orange tint."
          }
        }
      }
    },
    "mark.creek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a dark spot at the front base of the dorsal fin and a broad head. Young fish have a dark lateral stripe ending in a spot near the tail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dunkler Fleck sitzt vorn am Ansatz der Rückenflosse. Der Kopf ist breit. Jungfische haben einen dunklen Seitenstreifen mit Fleck nahe der Schwanzflosse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tache sombre à l’avant de la base de la dorsale et tête large. Chez les jeunes, une bande latérale sombre se termine par une tache près de la queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancha oscura en la base anterior de la dorsal y cabeza ancha. Los juveniles tienen una banda lateral oscura que termina en una mancha cerca de la cola."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背鰭基部前方有一黑斑，頭部寬。幼魚體側有黑色縱帶，尾部附近末端形成暗斑。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقعة داكنة عند مقدمة قاعدة الزعنفة الظهرية ورأس عريض. للصغار شريط جانبي داكن ينتهي ببقعة قرب الذيل."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a dark spot at the front base of the dorsal fin and a broad head. Young fish have a dark lateral stripe ending in a spot near the tail."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a dark spot at the front base of the dorsal fin and a broad head. Young fish have a dark lateral stripe ending in a spot near the tail."
          }
        }
      }
    },
    "mark.idol": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two wide black bands cross a white and yellow disc-shaped body. A long white dorsal streamer rises above a projecting snout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei breite schwarze Bänder auf einem weißen und gelben, scheibenförmigen Körper. Über der vorspringenden Schnauze ragt ein langer weißer Rückenfaden auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux larges bandes noires traversent le corps discoïde blanc et jaune. Un long filament dorsal blanc s’élève au-dessus du museau saillant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos bandas negras anchas cruzan un cuerpo discoidal blanco y amarillo. Un largo filamento dorsal blanco se eleva sobre el hocico saliente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白黃相間的盤狀身體有兩條寬黑帶。吻部突出，背鰭延伸出細長白色絲狀鰭條。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شريطان أسودان عريضان يعبران جسماً قرصياً أبيض وأصفر. ترتفع راية ظهرية بيضاء طويلة فوق الخطم البارز."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Two wide black bands cross a white and yellow disc-shaped body. A long white dorsal streamer rises above a projecting snout."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Two wide black bands cross a white and yellow disc-shaped body. A long white dorsal streamer rises above a projecting snout."
          }
        }
      }
    },
    "home.largemouth": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated lakes and quiet river margins of central and eastern North America. Adults ambush smaller fish near cover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krautreiche Seen und ruhige Flussufer im mittleren und östlichen Nordamerika. Erwachsene lauern kleineren Fischen in Deckung auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacs végétalisés et rives calmes du centre et de l’est de l’Amérique du Nord. Les adultes guettent les petits poissons à couvert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagos con vegetación y orillas tranquilas del centro y este de Norteamérica. Los adultos acechan peces pequeños desde un refugio."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "北美中東部植被豐富的湖泊與緩流河岸。成魚在掩蔽物旁伏擊小魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحيرات ذات نباتات وضفاف هادئة في وسط أمريكا الشمالية وشرقها. تتربص الأسماك البالغة بالصغار قرب الغطاء النباتي."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated lakes and quiet river margins of central and eastern North America. Adults ambush smaller fish near cover."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated lakes and quiet river margins of central and eastern North America. Adults ambush smaller fish near cover."
          }
        }
      }
    },
    "home.western": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet shallows in Mississippi and Gulf drainages, extending into northeastern Mexico. Picks small invertebrates from the water surface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhige Flachgewässer des Mississippi- und Golfgebiets bis Nordostmexiko. Liest kleine Wirbellose von der Oberfläche ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eaux peu profondes et calmes des bassins du Mississippi et du golfe, jusqu’au nord-est du Mexique. Capture des invertébrés en surface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguas someras y quietas de las cuencas del Misisipi y del golfo hasta el noreste de México. Captura invertebrados en la superficie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分布於密西西比河及墨西哥灣流域，延伸至墨西哥東北部。在平靜淺水區捕食水面的小型無脊椎動物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مياه ضحلة هادئة في أحواض المسيسيبي والخليج حتى شمال شرق المكسيك. يلتقط اللافقاريات الصغيرة من سطح الماء."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet shallows in Mississippi and Gulf drainages, extending into northeastern Mexico. Picks small invertebrates from the water surface."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet shallows in Mississippi and Gulf drainages, extending into northeastern Mexico. Picks small invertebrates from the water surface."
          }
        }
      }
    },
    "home.eastern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still waters and vegetated ditch edges in Atlantic and eastern Gulf coastal drainages of the southeastern United States. Also introduced overseas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehende Gewässer und bewachsene Gräben der Atlantik- und östlichen Golfküste im Südosten der USA. Auch außerhalb Amerikas eingeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eaux calmes et fossés végétalisés des bassins côtiers de l’Atlantique et de l’est du golfe, dans le sud-est des États-Unis. Introduite outre-mer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguas quietas y zanjas con vegetación de las cuencas atlánticas y del este del golfo, en el sureste de Estados Unidos. Introducida en otros continentes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "美國東南部大西洋與墨西哥灣東岸流域的靜水及長有水草的溝邊；亦引入海外。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مياه ساكنة وحواف قنوات نباتية في أحواض الأطلسي وشرق الخليج بجنوب شرق الولايات المتحدة. أُدخلت إلى قارات أخرى."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Still waters and vegetated ditch edges in Atlantic and eastern Gulf coastal drainages of the southeastern United States. Also introduced overseas."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Still waters and vegetated ditch edges in Atlantic and eastern Gulf coastal drainages of the southeastern United States. Also introduced overseas."
          }
        }
      }
    },
    "home.channel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivers, deep pools and reservoirs across central and eastern North America. Barbels help detect insects, molluscs and small fish near the bottom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flüsse, tiefe Kolke und Stauseen im mittleren und östlichen Nordamerika. Barteln orten Insekten, Weichtiere und Fische am Grund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivières, fosses et retenues du centre et de l’est de l’Amérique du Nord. Les barbillons détectent insectes, mollusques et poissons près du fond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ríos, pozas profundas y embalses del centro y este de Norteamérica. Con los barbillones detecta insectos, moluscos y peces cerca del fondo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生活在北美中東部的河流、深潭及水庫，以觸鬚在水底附近探測昆蟲、軟體動物與小魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهار وبرك عميقة وخزانات في وسط أمريكا الشمالية وشرقها. تساعد اللوامس على اكتشاف الحشرات والرخويات والأسماك الصغيرة قرب القاع."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivers, deep pools and reservoirs across central and eastern North America. Barbels help detect insects, molluscs and small fish near the bottom."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivers, deep pools and reservoirs across central and eastern North America. Barbels help detect insects, mollusks and small fish near the bottom."
          }
        }
      }
    },
    "home.redbreast": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlantic coastal streams of eastern North America. Often holds beside woody cover or rocks in flowing water and feeds on aquatic insects."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlantische Küstenflüsse im Osten Nordamerikas. Steht häufig bei Totholz oder Felsen in der Strömung und frisst Wasserinsekten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cours d’eau atlantiques de l’est de l’Amérique du Nord. Fréquente bois et rochers dans le courant et consomme des insectes aquatiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arroyos atlánticos del este de Norteamérica. Se refugia junto a madera o piedras en la corriente y come insectos acuáticos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "北美東部大西洋沿岸溪流。常停留在流水中的倒木或岩石旁，以水生昆蟲為食。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جداول الساحل الأطلسي شرقي أمريكا الشمالية. يبقى قرب الأخشاب أو الصخور في المياه الجارية ويتغذى على الحشرات المائية."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlantic coastal streams of eastern North America. Often holds beside woody cover or rocks in flowing water and feeds on aquatic insects."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlantic coastal streams of eastern North America. Often holds beside woody cover or rocks in flowing water and feeds on aquatic insects."
          }
        }
      }
    },
    "home.green": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pools in small streams and pond margins across central North America. Shelters under banks and eats insects, crayfish and small fish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bachkolke und Teichränder im mittleren Nordamerika. Sucht Schutz unter Ufern und frisst Insekten, Krebse und kleine Fische."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fosses de petits cours d’eau et bords d’étangs du centre de l’Amérique du Nord. S’abrite sous les berges et mange insectes, écrevisses et petits poissons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozas de arroyos y bordes de estanques del centro de Norteamérica. Se refugia bajo las orillas y come insectos, cangrejos de río y peces pequeños."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "北美中部的小溪深潭與池塘邊緣。在河岸下方躲藏，捕食昆蟲、螯蝦及小魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برك الجداول الصغيرة وحواف البرك في وسط أمريكا الشمالية. يحتمي تحت الضفاف ويتغذى على الحشرات وجراد الماء والأسماك الصغيرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pools in small streams and pond margins across central North America. Shelters under banks and eats insects, crayfish and small fish."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pools in small streams and pond margins across central North America. Shelters under banks and eats insects, crayfish and small fish."
          }
        }
      }
    },
    "home.pumpkin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated shallows of ponds and lakes in eastern North America. Its throat teeth crush snails and other hard-shelled prey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewachsene Flachwasserzonen in Teichen und Seen im Osten Nordamerikas. Mit Schlundzähnen zerknackt er Schnecken und andere hartschalige Beute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herbiers peu profonds des lacs et étangs de l’est de l’Amérique du Nord. Les dents pharyngiennes broient escargots et autres proies à coquille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas someras con vegetación de estanques y lagos del este de Norteamérica. Los dientes faríngeos trituran caracoles y otras presas con concha."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "北美東部池塘與湖泊的淺水草區。咽齒可壓碎螺類及其他帶硬殼的獵物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناطق ضحلة نباتية في برك وبحيرات شرقي أمريكا الشمالية. تسحق أسنان البلعوم القواقع وفرائس أخرى صلبة القشرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated shallows of ponds and lakes in eastern North America. Its throat teeth crush snails and other hard-shelled prey."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegetated shallows of ponds and lakes in eastern North America. Its throat teeth crush snails and other hard-shelled prey."
          }
        }
      }
    },
    "home.yellow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakes and slow rivers in eastern and central North America. Schools gather near weed beds or open bottoms and feed on insects and small fish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen und langsam fließende Flüsse im östlichen und mittleren Nordamerika. Schwärme fressen Insekten und kleine Fische an Krautbetten oder über freiem Grund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacs et rivières lentes de l’est et du centre de l’Amérique du Nord. Les bancs se nourrissent d’insectes et de petits poissons près des herbiers ou du fond dégagé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagos y ríos lentos del este y centro de Norteamérica. Forma bancos cerca de plantas o fondos abiertos y come insectos y peces pequeños."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "北美中東部的湖泊與緩流河川。常在水草旁或開闊水底群游，捕食昆蟲與小魚。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحيرات وأنهار بطيئة في شرقي أمريكا الشمالية ووسطها. تتجمع أسراب قرب النباتات أو فوق القاع المكشوف وتتغذى على الحشرات والأسماك الصغيرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakes and slow rivers in eastern and central North America. Schools gather near weed beds or open bottoms and feed on insects and small fish."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakes and slow rivers in eastern and central North America. Schools gather near weed beds or open bottoms and feed on insects and small fish."
          }
        }
      }
    },
    "home.creek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headwater streams and sheltered pools in central and eastern North America. It feeds on insects and other invertebrates along the streambed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberläufe und geschützte Kolke im mittleren und östlichen Nordamerika. Frisst Insekten und andere Wirbellose am Bachgrund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Têtes de bassin et fosses abritées du centre et de l’est de l’Amérique du Nord. Consomme insectes et autres invertébrés sur le lit des ruisseaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeceras de arroyos y pozas protegidas del centro y este de Norteamérica. Come insectos y otros invertebrados del lecho."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "棲息於北美中東部的上游溪流及隱蔽水潭，在溪底覓食昆蟲與其他無脊椎動物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جداول المنابع والبرك المحمية في وسط أمريكا الشمالية وشرقها. يقتات على الحشرات واللافقاريات الأخرى في قاع الجداول."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Headwater streams and sheltered pools in central and eastern North America. It feeds on insects and other invertebrates along the streambed."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Headwater streams and sheltered pools in central and eastern North America. It feeds on insects and other invertebrates along the streambed."
          }
        }
      }
    },
    "home.idol": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tropical Indo-Pacific reefs and lagoons. Its narrow snout reaches sponges and other food growing in reef crevices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tropische Riffe und Lagunen des Indopazifiks. Mit der schmalen Schnauze erreicht er Schwämme und andere Nahrung in Riffspalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récifs et lagons tropicaux de l’Indo-Pacifique. Son museau étroit atteint éponges et autres aliments dans les fissures du récif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrecifes y lagunas del Indo-Pacífico tropical. Su hocico estrecho alcanza esponjas y otros alimentos en grietas del arrecife."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分布於熱帶印度太平洋珊瑚礁及潟湖，以細吻攝食礁石縫內生長的海綿等食物。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شعاب وبحيرات ساحلية استوائية في المحيطين الهندي والهادئ. يصل بخطمه الضيق إلى الإسفنج وغيره من الغذاء داخل شقوق الشعاب."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tropical Indo-Pacific reefs and lagoons. Its narrow snout reaches sponges and other food growing in reef crevices."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tropical Indo-Pacific reefs and lagoons. Its narrow snout reaches sponges and other food growing in reef crevices."
          }
        }
      }
    },
