    "reminderValue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a species reminder at 9:00 and a photo challenge on the first day of each season. Scheduled on this device; no server is involved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte um 9 Uhr einen Artenhinweis und zu Saisonbeginn eine Fotoaufgabe. Nur auf diesem Gerät geplant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel d’espèce à 9 h et un défi photo le premier jour de chaque saison. Programmés sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio de especie a las 9:00 y un reto el primer día de cada temporada. Programados en este dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天上午 9 時提醒查看一種魚，每季首日提醒開始攝影挑戰。提醒由此裝置排程。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقَّ تذكيراً بنوع من الأسماك عند التاسعة صباحاً، وبالتحدي في أول يوم من كل موسم. تُجدول التذكيرات على جهازك."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a species reminder at 9:00 and a photo challenge on the first day of each season. Scheduled on this device; no server is involved."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a species reminder at 9:00 and a photo challenge on the first day of each season. Scheduled on this device; no server is involved."
          }
        }
      }
    },
