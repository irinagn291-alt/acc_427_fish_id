    "seasonNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing varies with latitude and water temperature. This is biology, not an open fishing season."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit variiert mit Breitengrad und Wassertemperatur. Dies ist Biologie, keine Fangfreigabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période varie selon la latitude et la température. Il s’agit de biologie, pas d’une saison de pêche autorisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La época varía con la latitud y temperatura. Es información biológica, no una temporada legal de pesca."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際時間依緯度和水溫而異。繁殖季描述的是生物習性，開放捕撈期間請查閱當地規定。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختلف الموعد باختلاف خط العرض وحرارة المياه. يصف هذا موسم التكاثر؛ راجع القواعد المحلية لمعرفة أوقات الصيد المسموح بها."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing varies with latitude and water temperature. This is biology, not an open fishing season."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing varies with latitude and water temperature. This is biology, not an open fishing season."
          }
        }
      }
    },
