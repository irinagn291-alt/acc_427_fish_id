    "demoNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pink stripe reaches the gill cover. Tiny black spots cover the back and tail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein rosa Streifen reicht bis zum Kiemendeckel. Kleine schwarze Punkte bedecken Rücken und Schwanz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bande rose atteint l’opercule. De petits points noirs couvrent le dos et la queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una banda rosa llega al opérculo. Pequeños puntos negros cubren el dorso y la cola."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側面的粉紅帶延伸至鰓蓋，背部與尾鰭布滿細小黑點。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمتد شريط وردي حتى غطاء الخياشيم. تغطي الظهر والذيل نقط سوداء صغيرة."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A pink stripe reaches the gill cover. Tiny black spots cover the back and tail."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A pink stripe reaches the gill cover. Tiny black spots cover the back and tail."
          }
        }
      }
    },
